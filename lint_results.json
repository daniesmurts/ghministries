allout: ({ value }: { value: { type: 'info' | 'warning' | 'success'; text: string } }) => {\n      const styles = {\n        info: 'bg-blue-50 border-blue-200 text-blue-800',\n        warning: 'bg-yellow-50 border-yellow-200 text-yellow-800',\n        success: 'bg-green-50 border-green-200 text-green-800',\n      }\n      const style = styles[value.type] || styles.info\n      return (\n        <div className={`p-4 my-6 border-l-4 rounded-r-md ${style}`}>\n          {value.text}\n        </div>\n      )\n    },\n    videoEmbed: ({ value }: { value: { url: string; caption?: string } }) => {\n      return (\n        <div className=\"my-8 aspect-video w-full rounded-lg overflow-hidden\">\n           <iframe\n            src={value.url}\n            className=\"w-full h-full\"\n            frameBorder={0}\n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n            allowFullScreen\n          />\n          {value.caption && (\n            <p className=\"mt-2 text-center text-sm text-gray-500 italic\">{value.caption}</p>\n          )}\n        </div>\n      )\n    },\n  },\n  marks: {\n    link: ({ children, value }: { children: React.ReactNode; value?: { href: string; blank?: boolean } }) => {\n      if (!value?.href) return <>{children}</>\n      const rel = !value.href.startsWith('/') ? 'noreferrer noopener' : undefined\n      const target = value.blank ? '_blank' : undefined\n      return (\n        <a href={value.href} rel={rel} target={target} className=\"text-purple-600 underline hover:text-purple-800 transition\">\n          {children}\n        </a>\n      )\n    },\n    scripture: ({ children, value }: { children: React.ReactNode; value?: { version: string } }) => {\n      return (\n        <span className=\"bg-orange-50 text-orange-700 px-1 rounded font-medium border border-orange-100\">\n          {children} {value?.version && <span className=\"text-xs uppercase ml-1 opacity-70\">({value.version})</span>}\n        </span>\n      )\n    },\n  },\n}\n\nexport function PortableText({ value }: { value: SanityBlock[] | any }) {\n  return (\n    <div className=\"prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-purple-600\">\n      <SanityPortableText value={value} components={components} />\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/components/ui/SectionHeader.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/components/ui/Select.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/components/ui/Skeleton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/components/ui/Tag.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/components/ui/Textarea.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/i18n/request.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/daniel/Documents/office/Dev/ghministries/src/i18n/routin